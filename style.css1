* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
    scroll-behavior: smooth;
}

body {
    background: #100e1c;
    color: white;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: #19162a;
}

header h1 {
    color: #c084fc;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

nav a:hover {
    color: #c084fc;
}

.hero {
    text-align: center;
    padding: 90px 20px;
    background: linear-gradient(135deg, #25153e, #10101b);
}

.hero h2 {
    font-size: 38px;
    margin-bottom: 15px;
}

.hero p {
    color: #c4b5fd;
    margin-bottom: 25px;
}

.btn, button {
    background: #8b5cf6;
    color: white;
    border: none;
    padding: 12px 20px;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
}

button:hover, .btn:hover {
    background: #a78bfa;
    transform: translateY(-2px);
}

.section-title {
    text-align: center;
    margin: 40px 0 25px;
    font-size: 28px;
}

.movies {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 25px;
    padding: 20px;
}

.movie {
    background: #211d35;
    width: 260px;
    padding: 18px;
    border-radius: 15px;
    text-align: center;
    transition: 0.3s;
}

.movie:hover {
    transform: translateY(-7px);
}

.poster {
    height: 190px;
    border-radius: 10px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 75px;
    margin-bottom: 15px;
}

.poster1 {
    background: linear-gradient(135deg, #312e81, #06b6d4);
}

.poster2 {
    background: linear-gradient(135deg, #450a0a, #f59e0b);
}

.poster3 {
    background: linear-gradient(135deg, #047857, #a3e635);
}

.movie h3 {
    margin-bottom: 10px;
}

.movie p {
    margin: 8px 0;
    color: #cbd5e1;
}

.movie button {
    margin-top: 10px;
    width: 100%;
}

.booking {
    background: #211d35;
    max-width: 600px;
    margin: auto;
    padding: 25px;
    border-radius: 15px;
}

.booking p {
    margin: 15px 0;
}

select {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    margin: 12px 0;
    background: #100e1c;
    color: white;
    border: 1px solid #8b5cf6;
}

.screen {
    background: white;
    color: #100e1c;
    text-align: center;
    padding: 10px;
    margin: 25px 0;
    border-radius: 50% 50% 8px 8px;
    box-shadow: 0 0 20px #c084fc;
}

.seats {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 10px;
    margin: 25px 0;
}

.seat {
    background: #16a34a;
    height: 30px;
    border-radius: 6px 6px 3px 3px;
    cursor: pointer;
}

.seat.selected {
    background: #a855f7;
}

.seat.occupied {
    background: #64748b;
    cursor: not-allowed;
}

.legend {
    display: flex;
    justify-content: space-around;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 13px;
}

.confirm {
    width: 100%;
    margin-top: 15px;
}

#message {
    text-align: center;
    color: #86efac;
    font-weight: bold;
}

footer {
    text-align: center;
    padding: 25px;
    margin-top: 40px;
    background: #19162a;
    color: #94a3b8;
}

@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    .hero h2 {
        font-size: 27px;
    }

    .booking {
        margin: 15px;
    }

    .seats {
        gap: 5px;
    }
}